# Set these on the hosting server (do not expose them in VITE_* variables).
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FEEDBACK_DB_PATH=./data/feedback.sqlite
ADMIN_USERNAME=change-this-username
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Set true only when the app is behind a trusted reverse proxy such as Nginx/Caddy.
TRUST_PROXY=false
